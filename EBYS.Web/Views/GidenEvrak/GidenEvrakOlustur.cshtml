@using EBYS.Web.Models.Ui
@{
    ViewData["Title"] = "Evrak Oluştur";
}



<div class="ebys-page ebys-giden-evrak py-4">
    <input type="hidden" id="EvrakId" value="@ViewBag.EvrakId" />
    <header class="ebys-page-titlebar">
        <div>
            <h1 class="ebys-page-titlebar__title"><i class="k-icon k-i-file-pdf" aria-hidden="true"></i>Evrak Oluştur</h1>
        </div>
        @await Component.InvokeAsync("ActionButton", new ActionButtonModel
        {
            Id = "evrakKaydet",
            Text = "Evrak Oluştur",
            IconClass = "k-icon k-i-file",
            Variant = ActionButtonVariant.Primary
        })
    </header>

    <section class="ebys-surface">
        <div class="card-body p-4">
        <ul class="nav nav-tabs mb-3" id="evrakTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="bilgiler-tab" data-bs-toggle="tab" data-bs-target="#bilgiler" type="button" role="tab">Bilgileri</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="alici-tab" data-bs-toggle="tab" data-bs-target="#alici" type="button" role="tab">Alıcı Ekle</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="ekler-tab" data-bs-toggle="tab" data-bs-target="#ekler" type="button" role="tab">Ekleri</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="ilgili-tab" data-bs-toggle="tab" data-bs-target="#ilgili" type="button" role="tab">İlgilileri</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="gorunum-tab" data-bs-toggle="tab" data-bs-target="#gorunum" type="button" role="tab">Evrak Görünüm</button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="bilgiler">
                @await Html.PartialAsync("Components/GidenEvrak/_EvrakBilgileriPartial")
            </div>

            <div class="tab-pane fade" id="alici">
                @await Html.PartialAsync("Components/GidenEvrak/_AliciBilgileriPartial")
            </div>

      
            <div class="tab-pane fade" id="ekler">
                @await Html.PartialAsync("Components/GidenEvrak/_EklerPartial")
            </div>

            <div class="tab-pane fade" id="ilgili">
                @await Html.PartialAsync("Components/GidenEvrak/_IlgilerPartial")
            </div>
            

            <div class="tab-pane fade" id="gorunum">
                @await Html.PartialAsync("Components/GidenEvrak/_GorunumPartial")
            </div>

            
        </div>
    </div>
    </section>
</div>


@await Html.PartialAsync("Components/GidenEvrak/_AiResmiYaziModalPartial")
<script src="~/js/GidenEvrak/ai-resmi-yazi-modal.js" asp-append-version="true"></script>
<script src="~/js/GidenEvrak/evrak-olustur.js"></script>

@section Styles {
    <link rel="stylesheet" href="~/css/GidenEvrak/editor-toolbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/GidenEvrak/ai-resmi-yazi-modal.css" asp-append-version="true" />

}

