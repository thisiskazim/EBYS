<div class="ebys-page py-4">
    <input type="hidden" id="Id" value="@(ViewBag.Id ?? 0)" />

    <header class="ebys-page-titlebar">
        <h1 class="ebys-page-titlebar__title"><i class="k-icon k-i-buildings" aria-hidden="true"></i>Tüzel Kişi Bilgileri</h1>
        @await Component.InvokeAsync("ActionButton", new ActionButtonModel
        {
            Text = "Kayıtlıdan Ara",
            IconClass = "k-icon k-i-search",
            Href = "#",
            Variant = ActionButtonVariant.Secondary
        })
    </header>

    <section class="ebys-surface ebys-form-surface">
        <div class="row g-4">
            <div class="col-md-6 ebys-form-section pe-md-4">
                <div class="ebys-field">
                    <label class="ebys-field-label" for="Adi">Tüzel Adı *</label>
                    @(Html.Kendo().TextBox().Name("Adi")
                        .Placeholder("Örn: Star Otomotiv")
                        .HtmlAttributes(new { style = "width: 100%", @class = "ebys-field-control", id = "Adi" }))
                </div>

                <div class="ebys-field">
                    <label class="ebys-field-label" for="Telefon">Telefon</label>
                    @(Html.Kendo().TextBox().Name("Telefon")
                        .Placeholder("0(5XX) XXX XX XX")
                        .HtmlAttributes(new { style = "width: 100%", @class = "ebys-field-control", id = "Telefon" }))
                </div>

                <div class="ebys-field">
                    <label class="ebys-field-label" for="Adress">Adres</label>
                    @(Html.Kendo().TextBox().Name("Adress")
                        .Placeholder("Tam adres bilgisi...")
                        .HtmlAttributes(new { style = "width: 100%", @class = "ebys-field-control", id = "Adress" }))
                </div>

                <div class="ebys-field mb-0">
                    <label class="ebys-field-label" for="EPosta">Mail Adresi</label>
                    @(Html.Kendo().TextBox().Name("EPosta")
                        .Placeholder("kurum@mail.com")
                        .HtmlAttributes(new { style = "width: 100%", @class = "ebys-field-control", id = "EPosta" }))
                </div>
            </div>

            <div class="col-md-6 ebys-form-section">
                <div class="ebys-field">
                    <label class="ebys-field-label" for="VergiNo">Vergi No</label>
                    @(Html.Kendo().TextBox().Name("VergiNo")
                        .Placeholder("Vergi numarasını giriniz...")
                        .HtmlAttributes(new { style = "width: 100%", @class = "ebys-field-control", id = "VergiNo" }))
                </div>

                <div class="ebys-field">
                    <label class="ebys-field-label" for="VergiDairesi">Vergi Dairesi</label>
                    @(Html.Kendo().TextBox().Name("VergiDairesi")
                        .Placeholder("Vergi dairesi adını giriniz...")
                        .HtmlAttributes(new { style = "width: 100%", @class = "ebys-field-control", id = "VergiDairesi" }))
                </div>

                <div class="ebys-field mb-0">
                    <label class="ebys-field-label" for="MersisNo">MERSİS No</label>
                    @(Html.Kendo().TextBox().Name("MersisNo")
                        .Placeholder("MERSİS numarasını giriniz...")
                        .HtmlAttributes(new { style = "width: 100%", @class = "ebys-field-control", id = "MersisNo" }))
                </div>
            </div>
        </div>

        <footer class="ebys-form-actions">
            @await Component.InvokeAsync("ActionButton", new ActionButtonModel
            {
                Text = "Listeye Dön",
                IconClass = "k-icon k-i-undo",
                Href = "/TuzelKisiMuhatap/Listele",
                Variant = ActionButtonVariant.Secondary
            })
            @await Component.InvokeAsync("ActionButton", new ActionButtonModel
            {
                Id = "btnKaydet",
                Text = "Kaydet / Güncelle",
                IconClass = "k-icon k-i-save",
                OnClick = "module.kaydet()",
                Variant = ActionButtonVariant.Primary
            })
        </footer>
    </section>
</div>

<script src="~/js/TuzelKisiMuhatap/ekle.js"></script>
