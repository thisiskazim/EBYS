@{
    ViewData["Title"] = "Gelen Evrak Kayıt";
}

<div class="ebys-page py-4">
    <input type="hidden" id="EvrakId" value="@ViewBag.EvrakId" />

    <header class="ebys-page-titlebar">
        <div>
            <h1 class="ebys-page-titlebar__title"><i class="k-icon k-i-file-pdf" aria-hidden="true"></i>Gelen Evrak Kayıt</h1>
        </div>
        @await Component.InvokeAsync("ActionButton", new ActionButtonModel
        {
            Id = "evrakKaydet",
            Text = "Evrakı Kaydet",
            IconClass = "k-icon k-i-check",
            Variant = ActionButtonVariant.Primary
        })
    </header>

    <div class="row g-3">
        <div class="col-md-5">
            <section class="ebys-surface ebys-document-panel">
                <div class="card-body ebys-document-panel__body p-2">
                    <ul class="nav nav-tabs mb-3" id="evrakTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" id="bilgiler-tab" data-bs-toggle="tab" data-bs-target="#bilgiler" type="button">Evrak Bilgileri</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="ekler-tab" data-bs-toggle="tab" data-bs-target="#ekler" type="button">Ekleri</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="ilgili-tab" data-bs-toggle="tab" data-bs-target="#ilgili" type="button">İlgilileri</button>
                        </li>
                    </ul>

                    <div class="tab-content p-2 rounded bg-white">
                        <div class="tab-pane fade show active" id="bilgiler">
                            @await Html.PartialAsync("Components/GelenEvrak/_EvrakBilgileriPartial")
                        </div>
                        <div class="tab-pane fade" id="ekler">
                            @await Html.PartialAsync("Components/GelenEvrak/_EklerPartial")
                        </div>
                        <div class="tab-pane fade" id="ilgili">
                            @await Html.PartialAsync("Components/GelenEvrak/_IlgilerPartial")
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-md-7">
            <section class="ebys-surface ebys-document-panel">
                <div class="card-header ebys-document-panel__header bg-dark text-white d-flex justify-content-between align-items-center py-1">
                    <span><i class="k-icon k-i-file-pdf"></i> ASIL EVRAK (ÜST YAZI)</span>
                    <div class="d-flex align-items-center">
                        <input type="file" id="AsilEvrakDosya" style="display:none;" accept=".pdf" />
                        @await Component.InvokeAsync("ActionButton", new ActionButtonModel
                        {
                            Text = "Üst Yazı Yükle",
                            IconClass = "k-icon k-i-upload",
                            OnClick = "$('#AsilEvrakDosya').click()",
                            Variant = ActionButtonVariant.Primary
                        })
                    </div>
                </div>

                <div class="card-body ebys-document-panel__body p-0 bg-secondary d-flex justify-content-center align-items-center position-relative">
                    <iframe id="pdf-preview-frame"
                            src=""
                            style="width:100%; height:100%; border:none; background-color: #525659; display:none;">
                    </iframe>

                    <div id="no-file-message" class="text-white text-center">
                        <i class="k-icon k-i-file-pdf" style="font-size: 4rem; opacity: 0.5;"></i>
                        <p>Lütfen önizlemek için bir dosya seçin</p>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<script src="~/js/GelenEvrak/gelenevrak-gorunum.js"></script>
<script src="~/js/GelenEvrak/gelenevrak-bilgileri.js"></script>
<script src="~/js/GelenEvrak/gelen-ekler.js"></script>
<script src="~/js/GelenEvrak/gelen-ilgiler.js"></script>
<script src="~/js/GelenEvrak/gelenevrak-olustur.js"></script>
