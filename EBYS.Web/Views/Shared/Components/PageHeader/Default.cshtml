@model PageHeaderModel


<div class="ebys-page-titlebar">
    <div>
        <h1 class="ebys-page-titlebar__title">@Model.Title</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb m-0">
                <li class="breadcrumb-item"><a href="javascript:void(0)" class="text-muted">@Model.BreadcrumbParent</a></li>
                <li class="breadcrumb-item active">@Model.BreadcrumbCurrent</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (Model.ShowFilterButton)
        {
            @await Component.InvokeAsync("ActionButton", new ActionButtonModel
            {
                Text = "Filtrele",
                Variant = ActionButtonVariant.Secondary,
                IconClass = "ri-filter-3-line",
                OnClick = Model.FilterJsFunction
            })
        }
        
        @if (Model.ShowNewActionButton)
        {
  
            if (Model.NewActionUrl.StartsWith("javascript:"))
            {
                var jsFunc = Model.NewActionUrl.Replace("javascript:", "");
                @await Component.InvokeAsync("ActionButton", new ActionButtonModel
                {
                    Text = Model.NewActionText,
                    Variant = ActionButtonVariant.Primary,
                    IconClass = "ri-add-circle-line",
                    OnClick = jsFunc
                })
            }
            else
            {
                @await Component.InvokeAsync("ActionButton", new ActionButtonModel
                {
                    Text = Model.NewActionText,
                    Variant = ActionButtonVariant.Primary,
                    IconClass = "ri-add-circle-line",
                    Href = Model.NewActionUrl
                })
            }
        }
    </div>
</div>

